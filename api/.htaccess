# Only index.php is reachable from the web; everything else in this folder is private.
Options -Indexes
<FilesMatch "^(?!index\.php$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
